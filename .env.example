# Copy to .env (local) or paste into the Portainer stack's environment variables.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- Database (only reachable inside the stack) ---
POSTGRES_USER=soundable
POSTGRES_PASSWORD=change-me
POSTGRES_DB=soundable

# --- Own API (terminal client) ---
# Password you type in `soundable login`. Only an argon2 hash is kept in memory.
ADMIN_PASSWORD=change-me
# Signs short-lived stream URLs. At least 32 characters.
SECRET_KEY=change-me-to-a-long-random-string-0000

# --- Subsonic API (iPhone app) ---
# Must be different from ADMIN_PASSWORD: Subsonic token auth forces the server to
# know this password in plaintext.
SUBSONIC_USER=admin
SUBSONIC_PASSWORD=change-me-too

# --- Limits ---
# Cloudflare Free/Pro reject request bodies > 100 MB, so keep this below 100.
MAX_UPLOAD_MB=95

# --- yt-dlp ---
# Optional Netscape-format cookies file mounted read-only into the containers,
# for when YouTube asks for sign-in. Leave empty to disable.
YTDLP_COOKIES_FILE=

# --- Backups (the `backup` service) ---
# Where backups go: a named volume by default, or a host path such as /mnt/nas/soundable
# (must be writable by uid 1000). Keep it on a different disk than Docker's data.
BACKUP_DIR=backups
BACKUP_INTERVAL_HOURS=24
# Number of database dumps to keep (the music mirror is incremental, not versioned).
BACKUP_KEEP=14

# --- Deployment ---
# Existing Docker network your cloudflared container is attached to.
PROXY_NETWORK=global
LOG_LEVEL=INFO
